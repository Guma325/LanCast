  <Geometry x:Key="IcoMonitor">M4,3 H20 A2,2 0 0 1 22,5 V15 A2,2 0 0 1 20,17 H4 A2,2 0 0 1 2,15 V5 A2,2 0 0 1 4,3 Z M8,21 H16 M12,17 V21</Geometry>
  <Geometry x:Key="IcoAudio">M2,10 V13 M6,6 V17 M10,3 V21 M14,8 V15 M18,5 V18 M22,10 V13</Geometry>
  <Geometry x:Key="IcoMic">M12,2 A3,3 0 0 1 15,5 V11 A3,3 0 0 1 9,11 V5 A3,3 0 0 1 12,2 Z M19,10 V12 A7,7 0 0 1 5,12 V10 M12,19 V22</Geometry>
