 <!-- 6 · Streams salvas -->
 <TabItem x:Name="SavedTab"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
 <DockPanel Margin="0,0,20,0">
  <Border DockPanel.Dock="Top" Style="{StaticResource SegGroup}" HorizontalAlignment="Left" Margin="0,0,0,12"><StackPanel Orientation="Horizontal">
   <RadioButton x:Name="SavedFilterAll" Style="{StaticResource SegButton}" GroupName="SavedFilter" IsChecked="True" Checked="SavedFilter_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="Todas"/><TextBlock x:Name="SavedAllCount" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/></StackPanel></RadioButton>
   <RadioButton x:Name="SavedFilterLive" Style="{StaticResource SegButton}" GroupName="SavedFilter" Checked="SavedFilter_Checked"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource BroadcastIcon}" Foreground="{DynamicResource Ok}" Margin="0,0,6,0"/><TextBlock Text="No ar"/><TextBlock x:Name="SavedLiveCount" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/></StackPanel></RadioButton>
  </StackPanel></Border>
  <Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SavedList" Margin="0,0,6,0"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="{DynamicResource Surface}" BorderBrush="{Binding CardLine, Mode=OneWay}" BorderThickness="1" CornerRadius="14" Padding="14,12,12,12" Margin="0,0,0,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="12" Background="{Binding IconBg, Mode=OneWay}"><Grid>
      <ContentControl Style="{StaticResource BroadcastIcon}" Width="22" Height="22" Foreground="{Binding IconFg, Mode=OneWay}" Visibility="{Binding ActiveVis, Mode=OneWay}"/>
      <Viewbox Width="20" Height="20" Visibility="{Binding InactiveVis, Mode=OneWay}"><Path Data="{StaticResource IcoBookmark}" Stroke="{Binding IconFg, Mode=OneWay}" StrokeThickness="2" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
     </Grid></Border>
     <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Name, Mode=OneWay}" Visibility="{Binding NameVis, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
      <TextBox Text="{Binding Name, Mode=OneWay}" Visibility="{Binding EditVis, Mode=OneWay}" Tag="{Binding Id}" MaxLength="40" MinHeight="34" MaxWidth="260" HorizontalAlignment="Left" Padding="8,4" IsVisibleChanged="SavedNameEdit_IsVisibleChanged" KeyDown="SavedNameEdit_KeyDown" LostKeyboardFocus="SavedNameEdit_LostFocus"/>
      <WrapPanel Margin="0,3,0,0"><TextBlock Text="{Binding Address, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,0,10,0"/><StackPanel Orientation="Horizontal" Visibility="{Binding StatusVis, Mode=OneWay}"><Ellipse Width="6" Height="6" Fill="{Binding StatusFg, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusFg, Mode=OneWay}" FontSize="12"/></StackPanel></WrapPanel>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="SavedOpen_Click" ToolTip="Abrir no navegador" AutomationProperties.Name="Abrir no navegador"><Viewbox Width="16" Height="16"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoExternal}"/></Viewbox></Button>
      <Button Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="SavedRename_Click" Margin="4,0,0,0" ToolTip="Renomear" AutomationProperties.Name="Renomear"><Viewbox Width="16" Height="16"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoPencil}"/></Viewbox></Button>
      <Button Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="SavedRemove_Click" Margin="4,0,0,0" ToolTip="Remover" AutomationProperties.Name="Remover"><Viewbox Width="16" Height="16"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}"/></Viewbox></Button>
     </StackPanel>
     <Grid Grid.Column="3" MinWidth="132" Margin="8,0,0,0" VerticalAlignment="Center">
      <Button Content="▶  Assistir" Style="{StaticResource PrimaryButton}" Height="40" HorizontalAlignment="Right" Tag="{Binding Id}" Click="SavedWatch_Click" Visibility="{Binding WatchVis, Mode=OneWay}" ToolTip="Abre a transmissão aqui no LanCast. Clique em outra para assistir lado a lado."/>
      <Border HorizontalAlignment="Right" CornerRadius="10" BorderBrush="{DynamicResource Control}" BorderThickness="1" Padding="14,0" Height="40" Visibility="{Binding OfflineVis, Mode=OneWay}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{DynamicResource Muted}" Margin="0,0,6,0"/><TextBlock Text="Offline" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel x:Name="SavedEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Nenhuma stream salva" Foreground="{DynamicResource Muted}" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Salve o IP de um amigo para ver quando ele estiver transmitindo." Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid>
 </DockPanel>
 <StackPanel Grid.Column="1">
  <Border Style="{StaticResource Panel}" Padding="18"><StackPanel><TextBlock Text="Salvar uma stream" FontSize="15" FontWeight="SemiBold"/>
   <TextBlock Text="Nome" FontSize="13" FontWeight="Medium" Margin="0,14,0,6"/><TextBox x:Name="SavedName" Tag="ex.: Guma" MaxLength="40" KeyDown="SavedField_KeyDown"/>
   <TextBlock Text="Endereço" FontSize="13" FontWeight="Medium" Margin="0,14,0,6"/><TextBox x:Name="SavedAddress" Tag="ex.: 26.51.157.46" FontFamily="{StaticResource Mono}" KeyDown="SavedField_KeyDown"/>
   <TextBlock x:Name="SavedMsg" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock Text="IP, IP:porta ou o link completo. Sem porta, usa 8080." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
   <Button Content="+  Salvar" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,14,0,0" Click="SavedAdd_Click"/></StackPanel></Border>
  <Border Style="{StaticResource Panel}" Padding="18" Margin="0,16,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Path Data="{StaticResource IcoInfo}" Stroke="{DynamicResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/></Viewbox><TextBlock Text="Como o status é verificado" FontWeight="SemiBold" Margin="8,0,0,0"/></StackPanel><TextBlock Text="Enquanto esta aba está aberta, o LanCast consulta cada endereço a cada poucos segundos. A stream aparece como no ar quando o LanCast da outra pessoa está transmitindo e o endereço responde." Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
 </StackPanel>
 </Grid></TabItem>

