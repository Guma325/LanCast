<Window x:Class="LanCast.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LanCast"
 Title="LanCast" Width="1240" Height="900" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" FontFamily="{StaticResource ProductFont}" FontSize="14"
 Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" Icon="pack://application:,,,/Assets/app.ico" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_KeyDown">
