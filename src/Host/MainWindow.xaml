  <Style x:Key="NavLabel" TargetType="TextBlock"><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Visibility" Value="{Binding NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvVis}}"/></Style>
 </Window.Resources>
 <Grid x:Name="RootGrid">
 <Grid x:Name="AppShell" Background="{DynamicResource Bg}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

 <!-- ================= Menu lateral ================= -->
 <Border x:Name="SideNav" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Width="264">
 <Grid Margin="14,18,14,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Grid.Row="0" Margin="4,0,0,6" MinHeight="40">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvVis}}">
   <Border Width="34" Height="34" Background="{DynamicResource Accent}" CornerRadius="10"><Viewbox Width="20" Height="20"><Path Data="{StaticResource IcoLogo}" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/></Viewbox></Border>
   <TextBlock Text="LanCast" FontWeight="Bold" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
  <Button x:Name="NavToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Padding="0" Background="{DynamicResource Surface}" Foreground="{DynamicResource Muted}" Click="NavToggle_Click" ToolTip="Recolher menu" AutomationProperties.Name="Recolher menu">
   <Viewbox x:Name="NavToggleImage" Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ico}" Data="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M9,3 V21 M16,15 L13,12 L16,9"/></Canvas></Viewbox></Button>
 </Grid>
 <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}" SelectionChanged="Navigation_Changed"><ListBox.Template><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ListBox.Template>
  <!-- Configurações fica no rodapé, acima do cartão de rede -->
  <ListBox.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="False"/></ItemsPanelTemplate></ListBox.ItemsPanel>
  <ListBoxItem Style="{StaticResource NavItem}" Tag="TRANSMISSÃO" ToolTip="Compartilhar" AutomationProperties.Name="Compartilhar"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoMonitor}"/></Viewbox><TextBlock Text="Compartilhar" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
  <ListBoxItem Style="{StaticResource NavItem}" ToolTip="Áudio dos apps" AutomationProperties.Name="Áudio dos apps"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoAudio}"/></Viewbox><TextBlock Text="Áudio dos apps" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
  <ListBoxItem Style="{StaticResource NavItem}" ToolTip="Microfone" AutomationProperties.Name="Microfone"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoMic}"/></Viewbox><TextBlock Text="Microfone" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
  <ListBoxItem Style="{StaticResource NavItem}" Tag="PÚBLICO" ToolTip="Espectadores" AutomationProperties.Name="Espectadores"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoUsers}"/></Viewbox><Border x:Name="ViewerBadge" DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Visibility="Collapsed"><TextBlock x:Name="ViewerBadgeText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Text}"/></Border><TextBlock Text="Espectadores" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
  <ListBoxItem Style="{StaticResource NavItem}" ToolTip="Banidos" AutomationProperties.Name="Banidos"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoBan}"/></Viewbox><Border x:Name="BanBadge" DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Background="{DynamicResource DangerSoft}" Visibility="Collapsed"><TextBlock x:Name="BanBadgeText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource DangerText}"/></Border><TextBlock Text="Banidos" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
  <ListBoxItem x:Name="WatchNavItem" Style="{StaticResource NavItem}" Tag="ASSISTIR" ToolTip="Assistindo amigos" AutomationProperties.Name="Assistindo amigos" Visibility="Collapsed"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoTv}"/></Viewbox><Border DockPanel.Dock="Right" Style="{StaticResource NavBadge}"><TextBlock x:Name="WatchBadgeText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Text}"/></Border><TextBlock Text="Assistindo amigos" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
  <ListBoxItem x:Name="SavedNavItem" Style="{StaticResource NavItem}" Tag="ASSISTIR" ToolTip="Streams salvas" AutomationProperties.Name="Streams salvas"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoBookmark}"/></Viewbox><Border x:Name="SavedBadge" DockPanel.Dock="Right" Style="{StaticResource NavBadge}" Background="{DynamicResource OkSoft}" Padding="4,1,6,1" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource BroadcastIcon}" Foreground="{DynamicResource Ok}" Margin="0,0,4,0"/><TextBlock x:Name="SavedBadgeText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Ok}" VerticalAlignment="Center"/></StackPanel></Border><TextBlock Text="Streams salvas" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
  <ListBoxItem Style="{StaticResource NavItem}" DockPanel.Dock="Bottom" ToolTip="Configurações" AutomationProperties.Name="Configurações"><DockPanel><Viewbox Width="18" Height="18"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoSliders}"/></Viewbox><TextBlock Text="Configurações" Style="{StaticResource NavLabel}"/></DockPanel></ListBoxItem>
 </ListBox>
 <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0" Visibility="{Binding NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvVis}}"><StackPanel>
  <StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Path Data="{StaticResource IcoShield}" Stroke="{DynamicResource Ok}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/></Viewbox><TextBlock Text="Rede detectada" Foreground="{DynamicResource Ok}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/></StackPanel>
  <TextBlock x:Name="NetworkLabel" Text="Rede local" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="Acesso não verificado" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></Border>
 <Viewbox Grid.Row="2" Width="20" Height="20" Margin="0,12" ToolTip="Rede detectada · acesso não verificado" Visibility="{Binding NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"><Path Data="{StaticResource IcoShield}" Stroke="{DynamicResource Ok}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/></Viewbox>
 <TextBlock x:Name="SideVersion" Grid.Row="3" FontSize="11" Foreground="{DynamicResource Muted}" Margin="6,10,0,0" Visibility="{Binding NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvVis}}"/>
 </Grid></Border>
 <Thumb x:Name="NavResizer" Style="{StaticResource NavResizerStyle}" Width="10" HorizontalAlignment="Right" Margin="0,0,-5,0" Panel.ZIndex="2" DragDelta="NavResizer_DragDelta" DragCompleted="NavResizer_DragCompleted" MouseDoubleClick="NavResizer_DoubleClick" ToolTip="Arraste para ajustar a largura · duplo clique volta ao padrão" Visibility="{Binding NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvVis}}"/>

 <!-- ================= Conteúdo ================= -->
 <Grid Grid.Column="1" Margin="28,20,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

 <!-- Barra "no ar": estado, estatísticas, atalho e Iniciar/Parar, sempre visível -->
 <Border x:Name="LiveBar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,10,10,10">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Ellipse x:Name="StatusDot" Style="{StaticResource LiveDot}" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusText" Text="Parado" FontSize="13" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="LiveTime" FontFamily="{StaticResource Mono}" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0" ClipToBounds="True">
    <Border Width="1" Height="22" Background="{DynamicResource Control}" Margin="0,0,16,0"/>
    <TextBlock x:Name="SubStatus" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <StackPanel x:Name="LiveViewersPanel" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><Viewbox Width="14" Height="14"><Path Data="{StaticResource IcoUsers}" Stroke="{DynamicResource Muted}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24"/></Viewbox><TextBlock x:Name="LiveViewers" FontSize="13" Foreground="{DynamicResource Muted}" Margin="6,0,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="HotkeyHintPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"><TextBlock Text="Atalho" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/><Border Style="{StaticResource Kbd}"><TextBlock x:Name="HotkeyHint" FontFamily="{StaticResource Mono}" FontSize="11"/></Border></StackPanel>
   <Button x:Name="StartStop" Grid.Column="3" Height="44" MinWidth="186" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="StartStop_Click" Content="Iniciar transmissão"/>
  </Grid>
 </Border>

 <StackPanel Grid.Row="1" Margin="0,22,0,0"><TextBlock x:Name="PageTitle" Text="Compartilhar" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Escolha o que seus amigos vão ver." FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>

 <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,20,0,0">
 <!-- 0 · Compartilhar -->
 <TabItem x:Name="ShareTab"><Grid><Grid.Resources><DataTemplate x:Key="PICKCARD">
  <Button Style="{StaticResource CardButton}" Tag="{Binding Pick}" Click="Source_Click" Margin="0,0,0,8" Padding="10" AutomationProperties.Name="{Binding Name, Mode=OneWay}" Background="{Binding SelBg, Mode=OneWay}" BorderBrush="{Binding SelBorder, Mode=OneWay}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="32" CornerRadius="6" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Control}" BorderThickness="1" Margin="0,0,12,0"><Image Source="{Binding IconImage}" Width="18" Height="18"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel>
    <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource OnAccentSoft}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding CheckVis, Mode=OneWay}"/>
   </Grid>
  </Button>
 </DataTemplate></Grid.Resources><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*" MinWidth="280"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,20,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#07070C" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" MinHeight="170"><Grid>
   <Image x:Name="PreviewImg" Stretch="Uniform"/>
   <StackPanel VerticalAlignment="Center" Margin="24"><TextBlock x:Name="PreviewMsg" Text="Preparando prévia…" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/><Button x:Name="RecoverSource" Content="Escolher outra fonte" HorizontalAlignment="Center" Margin="0,16,0,0" Click="RecoverSource_Click" Visibility="Collapsed"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"><Border x:Name="PreviewLiveChip" Style="{StaticResource Chip}" Background="{DynamicResource LivePill}" Visibility="Collapsed"><TextBlock Text="AO VIVO" FontSize="11" FontWeight="Bold" Foreground="White"/></Border></StackPanel>
   <Border Style="{StaticResource OverlayChip}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"><TextBlock Text="Só você vê esta prévia" FontSize="11" Foreground="#D6D6E4"/></Border>
  </Grid></Border>
  <StackPanel Grid.Row="1" Margin="4,14,4,0">
   <TextBlock x:Name="SourceLabel" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SourceHint" FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
   <WrapPanel Margin="0,6,0,0"><CheckBox x:Name="PreviewCheck" Content="Prévia ao vivo" Style="{StaticResource Switch}" Click="PreviewCheck_Click" Margin="0,0,28,0"/><CheckBox x:Name="ShareMicCheck" Content="Microfone desligado" Style="{StaticResource Switch}" Click="MicToggle_Click"/></WrapPanel>
  </StackPanel>
  <TextBlock x:Name="CaptureNotice" Grid.Row="2" Text="Tela inteira inclui notificações e outras janelas.&#10;Prefira uma janela para limitar o que aparece." FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="4,8,4,2"/>
 </Grid></Border>
 <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="16"><DockPanel>
  <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Fonte da transmissão" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="36" Height="36" ToolTip="Atualizar fontes" AutomationProperties.Name="Atualizar fontes" Click="RefreshWindows_Click"><Viewbox Width="16" Height="16"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoRefresh}"/></Viewbox></Button></Grid>
  <Border DockPanel.Dock="Top" Style="{StaticResource SegGroup}" Margin="0,0,0,14"><UniformGrid Columns="2"><RadioButton x:Name="SourceTabScreens" Content="Telas" Style="{StaticResource SegButton}" GroupName="SourceTab" IsChecked="True" Checked="SourceTab_Checked"/><RadioButton x:Name="SourceTabWindows" Content="Janelas" Style="{StaticResource SegButton}" GroupName="SourceTab" Checked="SourceTab_Checked"/></UniformGrid></Border>
  <TextBlock x:Name="SourceAudioHint" DockPanel.Dock="Bottom" Text="Áudio de todos os apps não silenciados." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,6,0">
   <ItemsControl x:Name="MonitorList" ItemTemplate="{StaticResource PICKCARD}"/>
   <StackPanel x:Name="WindowsSection" Visibility="Collapsed"><ItemsControl x:Name="WindowList" ItemTemplate="{StaticResource PICKCARD}"/><TextBlock x:Name="WindowEmpty" Text="Nenhuma janela aberta encontrada" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
  </StackPanel></ScrollViewer>
 </DockPanel></Border>
 </Grid></TabItem>

 <!-- 1 · Áudio dos apps -->
 <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Style="{StaticResource Panel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Seu som continua igual" FontWeight="SemiBold"/><TextBlock Text="Os apps permitidos entram quando a transmissão está ativa. Você continua ouvindo normalmente." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
 <Border Grid.Row="1" Style="{StaticResource Panel}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Aplicativos detectados" Style="{StaticResource Heading}" FontSize="15" Margin="0,0,0,16"/><Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="AppList" Margin="0,0,10,0">
  <ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16,8,8,8" Margin="0,0,0,8" ToolTip="{Binding Title, Mode=OneWay}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Ellipse Width="8" Height="8" Fill="{Binding Dot, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
     <Slider Grid.Column="2" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25" VerticalAlignment="Center" Opacity="{Binding SliderOpacity, Mode=OneWay}" Tag="{Binding Name}" Value="{Binding Volume, Mode=OneWay}" ValueChanged="AppVolume_Changed" AutomationProperties.Name="Volume do aplicativo"/>
     <TextBlock Grid.Column="3" Text="{Binding VolumeText, Mode=OneWay}" Foreground="{Binding PctFg, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
     <Button Grid.Column="4" Tag="{Binding Name}" Click="Mute_Click" Margin="14,0,0,0" Width="44" Height="40" Padding="0" MinWidth="0" VerticalAlignment="Center" Style="{StaticResource SmallButton}" ToolTip="{Binding MuteTip, Mode=OneWay}" AutomationProperties.Name="{Binding MuteTip, Mode=OneWay}" Background="{Binding MuteBg, Mode=OneWay}" BorderBrush="Transparent" Foreground="{Binding MuteFg, Mode=OneWay}">
      <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
       <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M11,5 L6,9 L3,9 L3,15 L6,15 L11,19 Z"/>
       <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding WavesVis, Mode=OneWay}" Data="M15.5,8.5 A5,5 0 0 1 15.5,15.5 M18.5,5.5 A9,9 0 0 1 18.5,18.5"/>
       <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding XVis, Mode=OneWay}" Data="M16,9 L22,15 M22,9 L16,15"/>
      </Canvas></Viewbox>
     </Button>
    </Grid>
   </Border>
  </DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl></ScrollViewer><StackPanel x:Name="AppEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Nenhum aplicativo com áudio detectado" Foreground="{DynamicResource Muted}"/><TextBlock Text="Abra um aplicativo e reproduza um som para ele aparecer aqui." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel></Grid></DockPanel></Border>
