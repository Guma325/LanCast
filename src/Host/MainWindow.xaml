  <Geometry x:Key="IcoExternal">M15,3 H21 V9 M10,14 L21,3 M18,13 V19 A2,2 0 0 1 16,21 H5 A2,2 0 0 1 3,19 V8 A2,2 0 0 1 5,6 H11</Geometry>
  <Geometry x:Key="IcoPencil">M12,20 H21 M16.5,3.5 A2.1,2.1 0 0 1 19.5,6.5 L7,19 L3,20 L4,16 Z</Geometry>
  <Geometry x:Key="IcoTrash">M3,6 H21 M8,6 V4 A2,2 0 0 1 10,2 H14 A2,2 0 0 1 16,4 V6 M19,6 L18,20 A2,2 0 0 1 16,22 H8 A2,2 0 0 1 6,20 L5,6</Geometry>
  <Geometry x:Key="IcoInfo">M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 M12,16 V12 M12,8 H12.01</Geometry>
  <Geometry x:Key="IcoPlus">M12,5 V19 M5,12 H19</Geometry>
  <Geometry x:Key="IcoLogo">M10,12 A2,2 0 1 0 14,12 A2,2 0 1 0 10,12 M16.24,7.76 A6,6 0 0 1 16.24,16.25 M7.76,16.24 A6,6 0 0 1 7.76,7.75 M19.07,4.93 A10,10 0 0 1 19.07,19.07 M4.93,19.07 A10,10 0 0 1 4.93,4.93</Geometry>
  <!-- Alça de redimensionar o menu lateral -->
  <Style x:Key="NavResizerStyle" TargetType="Thumb"><Setter Property="Cursor" Value="SizeWE"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border x:Name="line" Width="2" HorizontalAlignment="Center" Background="Transparent"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="line" Property="Background" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="line" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
