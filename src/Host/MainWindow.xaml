  <Geometry x:Key="IcoBookmark">M19,21 L12,16 L5,21 V5 A2,2 0 0 1 7,3 H17 A2,2 0 0 1 19,5 Z</Geometry>
  <Geometry x:Key="IcoSliders">M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23</Geometry>
